# Minecraft Server
MC_HOST=192.168.217.91
MC_PORT=25565
MC_USERNAME=Atlas
MC_USERNAME_2=Flora
MC_USERNAME_3=Forge
MC_USERNAME_4=Mason
MC_USERNAME_5=Blade
MC_VERSION=1.21.11
MC_AUTH=offline

# ── LLM backend ──────────────────────────────────────────────────────────────
# ollama (default, local) or openai (any OpenAI-compatible HTTP endpoint).
LLM_PROVIDER=openai

# Ollama (local LLM) — used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3.6:35b-a3b     # MoE — 35B-class quality at ~150 tok/s; used for ALL decisions
OLLAMA_FAST_MODEL=qwen3.6:35b-a3b # Same model: avoids VRAM eviction thrash between two models

# OpenAI-compatible API — used when LLM_PROVIDER=openai
# Works with OpenAI, OpenRouter, Groq, Together, vLLM, LiteLLM, LM Studio.
# Set the base URL to whatever the provider documents; it must end in /v1.
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
# OPENAI_MODEL has NO default — model IDs go stale fast, so name a current one.
# List what your key can actually reach:
#   curl https://api.openai.com/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
OPENAI_MODEL=openai/gpt-4.1-mini
OPENAI_FAST_MODEL=openai/gpt-4.1-mini
#
# Splitting these matters here: the fast model handles reactive decisions AND the
# critic, which is roughly two thirds of all calls. Putting the cheap model there
# is the single biggest cost lever.
#
# Other providers, for reference (check their current model lists too):
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1        OPENAI_MODEL=openai/gpt-5.6-terra
#   Groq        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   Together    OPENAI_BASE_URL=https://api.together.xyz/v1
#   vLLM/LiteLLM/LM Studio: point at your own host, any non-empty key
#
# NOTE: the bot asks for JSON via response_format={"type":"json_object"}. If a
# gateway rejects that field, use a model/provider that supports JSON mode — the
# decision loop parses every reply as JSON.
#
# NOTE: do NOT point OPENAI_BASE_URL at a local Ollama's /v1 endpoint to run a
# qwen3-family model. The `think` control does not exist in the OpenAI protocol,
# so the model reasons until it hits the token cap and returns empty content.
# Measured: qwen3.6:35b-a3b via /v1 returns "" while the same model over
# LLM_PROVIDER=ollama returns valid JSON. Use LLM_PROVIDER=ollama for local models.

# Twitch (optional - for chat integration)
TWITCH_CHANNEL=your_channel_name
TWITCH_BOT_USERNAME=your_bot_username
TWITCH_OAUTH_TOKEN=oauth:your_token_here

# YouTube (optional - for chat integration)
YOUTUBE_VIDEO_ID=your_live_video_id

# Bot Settings
BOT_NAME=Atlas
BOT_DECISION_INTERVAL_MS=500     # Legacy: minimum gap between decisions (used as floor)
BOT_IDLE_INTERVAL_MS=60000       # Conservative idle re-plan interval (ms)
BOT_CRITIC_ENABLED=false         # Avoid a paid critic call after every action
LLM_MAX_REQUESTS_PER_RUN=100     # Stop the process before request 101
BOT_CHAT_COOLDOWN_MS=3000
# Comma-separated Minecraft usernames allowed to use !status, !come, !stay,
# !resume, !goal, and !inventory. Empty disables all commands.
BOT_COMMAND_WHITELIST=
VIEWER_PORT=3020               # Single-agent 3D viewer; 3000 is busy on some DGX setups
WEB_BIND_HOST=127.0.0.1         # Set to your DGX Spark LAN IP for Windows access

# Multi-bot mode
ENABLE_MULTI_BOT=false   # Set to true to run bot team
BOT_COUNT=1              # Exactly one agent in Phase 1

# Logging
LOG_LEVEL=info           # debug | info | warn | error (debug shows full LLM prompts/responses)
# DEBUG=true             # Shortcut for LOG_LEVEL=debug


# Generated JavaScript is disabled unless the Linux x64 Bubblewrap qualification passes.
# Generation/refinement only creates quarantined candidates; operator verification and
# exact-SHA promotion are still required before a candidate can execute.
GENERATED_SKILLS_ENABLED=false
ENABLE_TTS=false
ENABLE_NEURAL_SERVER=false
GENERATED_SKILLS_BWRAP=/usr/bin/bwrap
# GENERATED_SKILLS_NODE=/absolute/path/to/node
# GENERATED_SKILLS_DIR=/absolute/path/to/private/generated-store
